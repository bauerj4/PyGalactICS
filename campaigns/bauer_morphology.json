{
  "name": "bauer_morphology",
  "artifacts": {
    "root": "notebooks/artifacts/bauer_morphology"
  },
  "run": {
    "skip_done": false,
    "verbose": true,
    "stages": ["solve", "sample", "evolve"],
    "reevolve_checkpoints": false
  },
  "particles": {
    "disk": 250000,
    "halo": 250000,
    "bulge": 0
  },
  "softening": {
    "disk": 0.15,
    "halo": 0.15,
    "bulge": 0.15
  },
  "parallel": {
    "mpi_ranks": 1,
    "core_fraction": 0.75
  },
  "sample": {
    "use_openmp": true,
    "n_openmp_threads": 0,
    "run_diskdf": true
  },
  "base_model": {
    "grid": {
      "name": "bauer_ai",
      "base": "milky_way_disk_halo",
      "axes": {},
      "omit_components": [[]],
      "coarse_grid": false,
      "physics_backend": "python"
    },
    "patch": {
      "disk.scale_height": 0.25,
      "disk.scale_length": 2.5,
      "disk_kinematics.toomre_q_target": 2.34
    }
  },
  "sweep": {
    "enabled": false
  },
  "evolve": {
    "end_time_gyr": 5.0,
    "dt_base": 0.02,
    "timestep_eta": 0.02,
    "max_timestep_bin": 5,
    "timestep_update_every": 2,
    "integrator_order": 2,
    "diagnostics_every": 50,
    "particle_dump_every": 200
  },
  "force": {
    "theta": 0.45,
    "rebuild_every": 10,
    "active_subset": true,
    "bh_optimizations_preset": "optimized",
    "bh_optimizations": {
      "preset": "optimized",
      "simd_leaves": true,
      "omp_schedule": "guided"
    }
  },
  "checkpoints_gyr": [0.0, 1.0, 2.5, 5.0]
}
